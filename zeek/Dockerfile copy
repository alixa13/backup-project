# Use the official Zeek image as the base
FROM zeek/zeek:latest


# Install necessary dependencies
RUN apt-get update && apt-get install -y \
    python3-pip python3-setuptools git cmake make gcc g++ libssl-dev librdkafka-dev libpcap-dev net-tools curl && \
    rm -rf /var/lib/apt/lists/*
# Install librdkafka from source
#RUN dig github.com
RUN curl -L https://github.com/edenhill/librdkafka/archive/v1.4.4.tar.gz | \
    tar xvz && \
    cd librdkafka-1.4.4/ && \
    ./configure && \
    make && \
    make install && \
    cd .. && \
    rm -rf librdkafka-1.4.4

# Install Zeek Package Manager (zkg)
#RUN pip3 install --no-cache-dir --upgrade pip --break-system-packages
RUN pip3 install --no-cache-dir zkg --break-system-packages

# Set environment variables for plugin compatibility
ENV LIBRDKAFKA_ROOT=/usr/local
ENV ZEEK_PLUGIN_PATH="/usr/local/zeek/lib/zeek/plugins"

# Install Kafka plugin using zkg
RUN zkg install  --skiptests --force https://github.com/SeisoLLC/zeek-kafka.git
# COPY zeek-kafka/. /tmp/zeek-kafka/
# RUN zkg install --skiptests --force /tmp/zeek-kafka

RUN apt-get update && apt-get install -y dnsutils
##RUN echo "@load Seiso/Kafka" > /usr/local/zeek/share/zeek/site/local.zeek
COPY zeek-config/. /usr/local/zeek/share/zeek/site/
COPY zeek-etc/. /usr/local/zeek/etc/

# Verify the Kafka plugin installation
RUN zeek -N Seiso::Kafka

# Default command to start Zeek
CMD ["zeekctl", "deploy"]