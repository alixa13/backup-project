<?xml version="1.0" encoding="UTF-8"?>
<!-- Log4j 2 config so components (e.g. StatusLogger) find a valid config and do not fail with "No configuration found at 'null' in 'null'" -->
<Configuration status="WARN" monitorInterval="0">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5p %-60c %x - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
