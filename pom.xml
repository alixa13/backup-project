<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.netsecml.platform</groupId>
  <artifactId>ml-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Network Security ML Platform</name>
  <description>
    Kafka conn telemetry -> Flink feature pipeline -> CPU ONNX inference -> Kafka outputs
    -> asynchronous ClickHouse archive. Java 21 / Flink 2.2.1, two-engineer MVP, no GPU.
    This POM defines the reactor only. Step 1 scope: empty, compiling child modules.
    Infrastructure and feature dependencies are added module-by-module in later
    implementation steps (see Repository_Structure.md, Section D and E).
  </description>

  <modules>
    <module>modules/domain</module>
    <module>modules/ports</module>
    <module>modules/application</module>
    <module>modules/adapter-kafka</module>
    <module>modules/adapter-flink</module>
    <module>modules/adapter-onnx</module>
    <module>modules/adapter-clickhouse</module>
    <module>modules/adapter-registry-filesystem</module>
    <module>modules/adapter-monitoring</module>
    <module>modules/bootstrap-online-job</module>
    <module>modules/bootstrap-archive-job</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <flink.version>2.2.1</flink.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
  </properties>

  <!--
    Dependency management is intentionally minimal in Step 1: only the shared test
    framework. Flink, Kafka, ONNX Runtime, ClickHouse, and Jackson versions are added
    to dependencyManagement here when their owning module is implemented, per the
    "Initial Java dependencies" list in Repository_Structure.md Section D.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-streaming-java</artifactId>
        <version>${flink.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-test-utils</artifactId>
        <version>${flink.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.kafka</groupId>
        <artifactId>kafka-clients</artifactId>
        <version>3.7.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-clients</artifactId>
        <version>${flink.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-base</artifactId>
        <version>${flink.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-kafka</artifactId>
        <version>5.0.0-2.2</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>kafka</artifactId>
        <version>1.21.4</version>
        <scope>test</scope>
      </dependency>
      <!-- Testcontainers copies files into a container through commons-compress,
           whose TarArchiveOutputStream references org.apache.commons.codec.Charsets.
           Nothing on the reactor's classpath provides commons-codec: Flink supplies
           commons-compress 1.26.0 but not its codec dependency, so every Kafka
           container test died with NoClassDefFoundError before reaching a single
           assertion. Test scope only; no production code needs it. -->
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>1.16.1</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>1.21.4</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.clickhouse</groupId>
        <artifactId>client-v2</artifactId>
        <version>0.9.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
