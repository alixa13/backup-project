# Copy to .env and fill in local values. Never commit the real .env file.
# No secrets belong in this repository or in committed config/ YAML — this file
# documents the variable names only.

# --- Kafka (external cluster) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- Kafka topics (external input, internal outputs) ---
# CONN_INPUT_TOPIC, FEATURE_VECTOR_TOPIC and DLQ_TOPIC predate DNS and keep
# their names and meanings unchanged so no existing deployment breaks -- they
# were never protocol-qualified to begin with.
CONN_INPUT_TOPIC=conn
FEATURE_VECTOR_TOPIC=netsec.conn.feature-vector.v1
DLQ_TOPIC=netsec.conn.dlq.v1
DNS_INPUT_TOPIC=dns
DNS_FEATURE_VECTOR_TOPIC=netsec.dns.feature-vector.v1
DNS_DLQ_TOPIC=netsec.dns.dlq.v1
# MODBUS_RAW_TOPIC (not *_INPUT_TOPIC): modbus's input topic was never an
# existing deployment's bare wire name the way conn's/dns's are -- it follows
# the newer netsec.modbus.raw.v1 naming from the start.
MODBUS_RAW_TOPIC=netsec.modbus.raw.v1
MODBUS_FEATURE_VECTOR_TOPIC=netsec.modbus.feature-vector.v1
MODBUS_DLQ_TOPIC=netsec.modbus.dlq.v1
# Every topic named in this file must exist before either job starts, even for a
# protocol a site does not run: a Kafka source on a missing topic fails its split
# enumerator, and the whole job -- all four protocols -- then restarts in a loop.
# s7comm (ICSNPP s7comm.log) follows modbus's netsec.<protocol>.raw.v1 naming.
# The producer must partition S7COMM_RAW_TOPIC by Zeek uid.
S7COMM_RAW_TOPIC=netsec.s7comm.raw.v1
S7COMM_FEATURE_VECTOR_TOPIC=netsec.s7comm.feature-vector.v1
S7COMM_DLQ_TOPIC=netsec.s7comm.dlq.v1
# Idle TTL of the per-connection s7comm state, in minutes (online job only).
# Set it above the longest outage the online job may have: after downtime longer
# than this, every s7comm connection restarts from empty state (processing-time TTL).
S7COMM_STATE_TTL_MINUTES=60
SENSOR_ID=sensor-default

# --- ClickHouse (archive sink only, never on the online scoring path) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=netsec_ml
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Flink ---
FLINK_CHECKPOINT_DIR=file:///var/lib/flink/checkpoints
FLINK_SAVEPOINT_DIR=file:///var/lib/flink/savepoints

# --- Model registry (read-only mounted volume) ---
MODEL_REGISTRY_ROOT=/models

# --- Monitoring ---
PROMETHEUS_PUSHGATEWAY=
LOG_LEVEL=INFO
